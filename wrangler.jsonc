{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blogc",
  "compatibility_date": "2026-10-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "_site"
  },
  "build": {
    // 必须是 Bundler，不能加 npx（npx 会去 npm 里找 bundle 包而失败）
    // BUNDLE_WITHOUT 必须和安装阶段保持一致：CF 安装时跳过 test 组（html-proofer 在里面），
    // 构建时若不带这个变量，bundler 会去找 test 组的 gem 而报 GemNotFound。
    "command": "BUNDLE_WITHOUT=development:test bundle exec jekyll build"
  }
}
