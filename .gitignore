# Bundler cache
.bundle
vendor
# Gemfile.lock 入库以锁定依赖版本，CI 构建可复现

# Jekyll cache
.jekyll-cache
.jekyll-metadata
.sass-cache
_site

# RubyGems
*.gem

# NPM dependencies
node_modules
package-lock.json

# Python
__pycache__/
*.py[cod]

# Logs
*.log

# 编辑器与合并残留
*.bak
*.orig
*.rej
*.swp
*.swo

# Python 虚拟环境（tools/process-gallery.py 依赖 Pillow）
.venv/
venv/

# IDE configurations（本地编辑器配置不入库）
.idea
.vscode/

# 本地开发容器配置，不属于站点内容
.devcontainer/

# 开发计划看板：本地维护，不入库也不发布（站点侧由 _config.yml 的 exclude 进一步排除）
plan.md

# Misc
_sass/vendors
assets/js/dist

# Gallery originals (processed copies live in assets/img/gallery)
photos_src

# Temporary image workspace
.addimage/

# Hidden system files
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.Spotlight-V100
.Trashes

# ZCode workspace files (local tooling, not part of the site)
.zcode/

# WorkBuddy 工作区数据（会话记忆、本地任务状态），只在本地维护
.workbuddy/
